DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/smartmeal_db"
DATABASE_URL_PRISMA="mysql://USER:PASSWORD@HOST:PORT/smartmeal_db"
DATABASE_SSL="true"
# Optional when TiDB asks for an explicit CA file path.
DATABASE_CA_PATH=""

# Optional. SmartMeal core recommendation must work without this key.
GEMINI_API_KEY=""

APP_URL="http://localhost:3000"

# Keep demo shortcuts only for local development. Set false when deploying.
ALLOW_DEMO_LOGIN="true"
